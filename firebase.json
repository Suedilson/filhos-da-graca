{
  "functions": { "source": "functions", "runtime": "nodejs22" },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist-deploy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
