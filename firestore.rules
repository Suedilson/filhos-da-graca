rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function superAdmin() {
      return signedIn() &&
        request.auth.token.email in ['suedilsonfilho@gmail.com'];
    }

    function userPermissionPath(uid) {
      return /databases/$(database)/documents/usuariosPermissoes/$(uid);
    }

    function userPermission() {
      return get(userPermissionPath(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() &&
        exists(userPermissionPath(request.auth.uid)) &&
        userPermission().ativo == true;
    }

    function hasPermission(permission) {
      return superAdmin() ||
        (activeUser() && permission in userPermission().permissoes);
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/membros/$(memberId);
    }

    // Perfil Administrador: único que configura o conteúdo do site e as permissões.
    function adminProfile() {
      return superAdmin() ||
        (activeUser() && userPermission().get('perfil', '') == 'admin');
    }

    // Louvor: quem tem a permissão ou cujo cadastro de membro tem "Louvor" no ministério.
    function louvorAccess() {
      return hasPermission('louvor') ||
        (activeUser() &&
          userPermission().get('membroId', '') is string &&
          userPermission().get('membroId', '') != '' &&
          exists(memberPath(userPermission().membroId)) &&
          get(memberPath(userPermission().membroId)).data.get('ministerio', '')
            .lower().matches('.*louvor.*'));
    }

    // A permissão Financeiro só pode ser concedida ou retirada pelo administrador geral.
    function grantsFinance(data) {
      return 'financeiro' in data.get('permissoes', []);
    }

    function financeUnchanged() {
      return grantsFinance(resource.data) == grantsFinance(request.resource.data);
    }

    function isOwnPermission(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isOwnMember(memberId) {
      return signedIn() &&
        exists(userPermissionPath(request.auth.uid)) &&
        get(userPermissionPath(request.auth.uid)).data.membroId == memberId;
    }

    function validPendingPermission(uid) {
      return isOwnPermission(uid) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'nome',
          'email',
          'perfil',
          'membroId',
          'ativo',
          'permissoes',
          'origemCadastro',
          'aguardandoAprovacao',
          'criadoEm',
          'atualizadoEm'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        // O membro vinculado precisa ser criado no mesmo lote e pertencer a este usuário,
        // impedindo o vínculo com o cadastro de outra pessoa.
        request.resource.data.membroId is string &&
        !exists(memberPath(request.resource.data.membroId)) &&
        existsAfter(memberPath(request.resource.data.membroId)) &&
        getAfter(memberPath(request.resource.data.membroId)).data.usuarioUid == uid &&
        request.resource.data.perfil == 'membro' &&
        request.resource.data.ativo == false &&
        request.resource.data.permissoes == ['meusDados'] &&
        request.resource.data.origemCadastro == 'autoCadastro' &&
        request.resource.data.aguardandoAprovacao == true;
    }

    function validPendingMember(memberId) {
      return signedIn() &&
        request.resource.data.keys().hasOnly([
          'nome',
          'email',
          'telefone',
          'nascimento',
          'endereco',
          'ministerio',
          'foto',
          'fotoPublicId',
          'status',
          'origemCadastro',
          'usuarioUid',
          'ativo',
          'criadoEm',
          'atualizadoEm'
        ]) &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() >= 2 &&
        request.resource.data.nome.size() <= 140 &&
        (!('foto' in request.resource.data) ||
          (request.resource.data.foto is string &&
            request.resource.data.foto.size() <= 500)) &&
        (!('fotoPublicId' in request.resource.data) ||
          (request.resource.data.fotoPublicId is string &&
            request.resource.data.fotoPublicId.size() <= 300)) &&
        request.resource.data.usuarioUid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'Pendente aprovação' &&
        request.resource.data.origemCadastro == 'autoCadastro' &&
        request.resource.data.ativo == false &&
        existsAfter(userPermissionPath(request.auth.uid)) &&
        getAfter(userPermissionPath(request.auth.uid)).data.membroId == memberId;
    }

    function validPrayerRequest() {
      return request.resource.data.keys().hasOnly([
          'nome',
          'telefone',
          'pedido',
          'lido',
          'criadoEm'
        ]) &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() >= 2 &&
        request.resource.data.nome.size() <= 120 &&
        request.resource.data.pedido is string &&
        request.resource.data.pedido.size() >= 3 &&
        request.resource.data.pedido.size() <= 2500 &&
        (!('telefone' in request.resource.data) ||
          (request.resource.data.telefone is string &&
            request.resource.data.telefone.size() <= 40)) &&
        request.resource.data.lido == false;
    }

    function validPublicBirthday(memberId) {
      return request.resource.data.keys().hasOnly([
          'membroId',
          'nome',
          'mes',
          'dia',
          'ministerio',
          'foto',
          'ativo',
          'atualizadoEm'
        ]) &&
        request.resource.data.membroId == memberId &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() >= 2 &&
        request.resource.data.nome.size() <= 140 &&
        request.resource.data.mes is int &&
        request.resource.data.mes >= 1 &&
        request.resource.data.mes <= 12 &&
        request.resource.data.dia is int &&
        request.resource.data.dia >= 1 &&
        request.resource.data.dia <= 31 &&
        request.resource.data.ministerio is string &&
        request.resource.data.foto is string &&
        request.resource.data.ativo is bool;
    }

    function memberSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome',
        'telefone',
        'nascimento',
        'endereco',
        'ministerio',
        'foto',
        'fotoPublicId',
        'observacoes',
        'atualizadoEm'
      ]);
    }

    match /programacao/{id} {
      allow read: if true;
      allow write: if adminProfile();
    }

    match /eventos/{id} {
      allow read: if true;
      allow write: if adminProfile();
    }

    match /videos/{id} {
      allow read: if true;
      allow write: if adminProfile();
    }

    match /documentos/{id} {
      allow read: if true;
      allow write: if adminProfile();
    }

    match /galeria/{id} {
      allow read: if true;
      allow write: if adminProfile();
    }

    // Carteirinhas: o QR code abre a verificação pública de um código (sem listar todas).
    match /carteirinhas/{codigo} {
      allow get: if true;
      allow list: if hasPermission('carteirinhas') || adminProfile();
      allow create: if (hasPermission('carteirinhas') || adminProfile()) &&
        request.resource.data.keys().hasOnly(['membroId', 'nome', 'funcao', 'numero', 'numeroSeq',
          'validade', 'emitidaEm', 'ativa', 'criadoEm']) &&
        request.resource.data.nome is string && request.resource.data.nome.size() <= 140 &&
        request.resource.data.funcao is string && request.resource.data.funcao.size() <= 60 &&
        request.resource.data.ativa == true;
      allow update: if (hasPermission('carteirinhas') || adminProfile()) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ativa', 'canceladaEm', 'substituidaEm']) &&
        request.resource.data.ativa == false;
      allow delete: if false;
    }

    match /aniversariantesPublicos/{id} {
      allow read: if true;
      allow create, update: if (hasPermission('membros') ||
        adminProfile() ||
        (activeUser() && isOwnMember(id))) &&
        validPublicBirthday(id);
      allow delete: if hasPermission('membros') ||
        adminProfile() ||
        (activeUser() && isOwnMember(id));
    }

    match /ensinoMateriais/{id} {
      allow read: if true;
      allow write: if hasPermission('ensino');
    }

    match /configuracoes/localizacao {
      allow read: if true;
      allow write: if adminProfile();
    }

    match /configuracoes/contribuicao {
      allow read: if true;
      allow write: if adminProfile();
    }

    // Texto do e-mail de aniversário: só o perfil Administrador lê e altera.
    match /configuracoes/emailAniversario {
      allow read: if adminProfile();
      allow write: if adminProfile() &&
        request.resource.data.keys().hasOnly(['assunto', 'titulo', 'mensagem', 'versiculo',
          'referencia', 'despedida', 'assinatura', 'assinaturaComplemento', 'atualizadoEm']) &&
        request.resource.data.get('mensagem', '') is string &&
        request.resource.data.get('mensagem', '').size() <= 4000;
    }

    match /configuracoes/emailBoasVindas {
      allow read: if adminProfile();
      allow write: if adminProfile() &&
        request.resource.data.keys().hasOnly(['assunto', 'titulo', 'mensagem', 'versiculo',
          'referencia', 'despedida', 'assinatura', 'assinaturaComplemento', 'atualizadoEm']) &&
        request.resource.data.get('mensagem', '') is string &&
        request.resource.data.get('mensagem', '').size() <= 4000;
    }

    match /configuracoes/youtube {
      allow read: if true;
      allow write: if adminProfile();
    }

    match /pedidosOracao/{id} {
      allow create: if validPrayerRequest();
      allow read, update, delete: if hasPermission('oracao');
    }

    match /usuariosPermissoes/{uid} {
      allow get: if isOwnPermission(uid) || adminProfile();
      allow list: if adminProfile();
      allow create: if (adminProfile() &&
          (superAdmin() || !grantsFinance(request.resource.data))) ||
        validPendingPermission(uid);
      allow update: if adminProfile() && (superAdmin() || financeUnchanged());
      allow delete: if superAdmin() ||
        (adminProfile() && !grantsFinance(resource.data));
    }

    match /membros/{id} {
      allow get: if hasPermission('membros') ||
        adminProfile() ||
        (activeUser() && isOwnMember(id));
      allow list: if hasPermission('membros') || adminProfile();
      allow create: if hasPermission('membros') || validPendingMember(id);
      allow update: if hasPermission('membros') ||
        adminProfile() ||
        (activeUser() && isOwnMember(id) && memberSelfUpdate());
      allow delete: if hasPermission('membros');
    }

    function validWorshipSchedule(data) {
      return data.keys().hasOnly(['titulo', 'data', 'horario', 'ministro',
        'observacoes', 'status', 'equipe', 'repertorio', 'versao',
        'atualizadoEm', 'atualizadoPor', 'responsavel']) &&
        data.titulo is string && data.titulo.size() > 0 && data.titulo.size() <= 180 &&
        data.data is string && data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.horario is string && data.horario.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.ministro is string && data.ministro.size() > 0 && data.ministro.size() <= 180 &&
        data.observacoes is string && data.observacoes.size() <= 10000 &&
        data.status in ['Confirmada', 'Rascunho', 'Realizada', 'Cancelada'] &&
        data.equipe is list && data.equipe.size() > 0 && data.equipe.size() <= 80 &&
        data.repertorio is list && data.repertorio.size() <= 50 &&
        data.versao is int && data.versao > 0 &&
        data.atualizadoPor == request.auth.uid && data.atualizadoEm == request.time &&
        data.responsavel is string;
    }

    match /louvorMusicas/{id} {
      allow read: if louvorAccess();
      allow create, update: if louvorAccess() &&
        request.resource.data.keys().hasOnly(['titulo', 'autor', 'letra', 'tom',
          'notas', 'ministros', 'ativo', 'atualizadoEm', 'atualizadoPor']) &&
        request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 &&
        request.resource.data.titulo.size() <= 180 &&
        request.resource.data.autor is string && request.resource.data.autor.size() <= 180 &&
        request.resource.data.letra is string && request.resource.data.letra.size() <= 40000 &&
        request.resource.data.tom is string && request.resource.data.tom.size() <= 40 &&
        request.resource.data.notas is string && request.resource.data.notas.size() <= 20000 &&
        request.resource.data.ministros is string && request.resource.data.ministros.size() <= 500 &&
        request.resource.data.ativo is bool &&
        request.resource.data.atualizadoPor == request.auth.uid &&
        request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }

    match /louvorEscalas/{id} {
      allow read: if louvorAccess();
      allow create: if louvorAccess() && validWorshipSchedule(request.resource.data) &&
        request.resource.data.versao == 1 &&
        getAfter(/databases/$(database)/documents/louvorEscalas/$(id)/historico/1).data == request.resource.data;
      allow update: if louvorAccess() && validWorshipSchedule(request.resource.data) &&
        request.resource.data.versao == resource.data.versao + 1 &&
        getAfter(/databases/$(database)/documents/louvorEscalas/$(id)/historico/$(string(request.resource.data.versao))).data == request.resource.data;
      // Excluir a escala exige a permissão Louvor marcada (ou perfil Administrador).
      // O histórico de versões fica guardado, sem poder ser apagado.
      allow delete: if hasPermission('louvor') || adminProfile();

      match /historico/{versao} {
        allow read: if louvorAccess();
        allow create: if louvorAccess() && validWorshipSchedule(request.resource.data) &&
          getAfter(/databases/$(database)/documents/louvorEscalas/$(id)).data == request.resource.data;
        allow update, delete: if false;
      }
    }

    match /contasBancarias/{id} {
      allow read, write: if hasPermission('financeiro');
    }

    match /arrecadacoes/{id} {
      allow read, write: if hasPermission('financeiro');
    }

    match /contasPagar/{id} {
      allow read, write: if hasPermission('financeiro');
    }

    match /aprovisionamentos/{id} {
      allow read, write: if hasPermission('financeiro');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
